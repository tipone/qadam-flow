#!/bin/sh
# Launcher for the Qadam Flow worker. Configuration comes from systemd
# (EnvironmentFile=/etc/qadam-flow/worker.conf); start it with
# `systemctl start qadam-flow-worker`, not by hand.
# --enable-source-maps matches the Docker entrypoint: the payload ships the
# .map files, and without the flag production stack traces lose their sources.
exec /usr/bin/node --enable-source-maps /usr/lib/qadam-flow/packages/server/worker/dist/src/bootstrap.js "$@"
